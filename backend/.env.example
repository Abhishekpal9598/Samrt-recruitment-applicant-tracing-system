# ==============================================================================
# SMART RECRUITMENT & APPLICANT TRACKING SYSTEM (ATS) - ENVIRONMENT CONFIGURATION
# Safe demonstration placeholders. Copy to .env and configure local values.
# ==============================================================================

# Server Runtime Configuration
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# Database Configuration (PostgreSQL 15+)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=[schema]
DATABASE_URL=postgresql://ats_user:ats_password_placeholder@localhost:5432/smart_ats_db?schema=public

# Cross-Origin Resource Sharing (CORS)
# Comma-separated list of allowed origin URLs
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Authentication Tokens (Placeholder secrets - generate random 256-bit strings for real deployments)
JWT_ACCESS_SECRET=placeholder_access_secret_for_development_purposes_only_32_chars_min
JWT_REFRESH_SECRET=placeholder_refresh_secret_for_development_purposes_only_32_chars_min
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# File Ingestion Ceiling
MAX_FILE_SIZE_BYTES=5242880

# Logging Verbosity: error | warn | info | http | debug
LOG_LEVEL=info
